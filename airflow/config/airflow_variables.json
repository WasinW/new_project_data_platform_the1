{
  "gcp_project_id": "ntt-test-data-bq-looker",
  "gcp_region": "asia-southeast1",
  "gcp_zone": "asia-southeast1-a",
  
  "s3_bucket": "demo-t1-analytics",
  "aws_access_key_id": "aws-s3-access-key-id",
  "aws_secret_access_key": "aws-s3-secret-access-key",

  "dataflow_network": "projects/ntt-test-data-bq-looker/global/networks/default",
  "dataflow_subnetwork": "projects/ntt-test-data-bq-looker/regions/asia-southeast1/subnetworks/default",
  "dataflow_service_account": "dataflow-sa@ntt-test-data-bq-looker.iam.gserviceaccount.com",
  
  "shared_infrastructure": {
    "datasets": {
      "raw": "raw_data",
      "staging": "staging_data",
      "refined": "refined_data",
      "analytics": "analytics_data",
      "audit": "audit_logs",
      "reconcile": "reconcile_temp",
      "batch_control": "batch_control",
      "reference": "reference_data"
    },
    "storage": {
      "staging_bucket": "ntt-test-data-bq-looker-staging",
      "raw_bucket": "ntt-test-data-bq-looker-raw",
      "temp_bucket": "ntt-test-data-bq-looker-dataflow-temp",
      "config_bucket": "ntt-test-data-bq-looker-pipeline-configs",
      "template_bucket": "ntt-test-data-bq-looker-dataflow-templates"
    },
    "pubsub": {
      "create_topic": "data-events-create",
      "update_topic": "data-events-update", 
      "delete_topic": "data-events-delete",
      "dlq_topic": "data-events-dlq",
      "processor_subscription": "data-events-processor-sub"
    },
    "dataplex": {
      "lake": "data-platform-lake",
      "raw_zone": "raw-zone",
      "refined_zone": "refined-zone",
      "analytics_zone": "analytics-zone"
    },
    "composer": {
      "environment": "data-platform-composer"
    }
  },
  
  "domains_config": {
    "member": {
      "tables": ["s_loy_program", "s_org_ext", "s_loy_tier", "s_loy_member"],
      "enabled": true,
      "config_path": "gs://ntt-test-data-bq-looker-pipeline-configs/member/config.yaml",
      "storage_subfolder": "member/"
    },
    "order": {
      "tables": ["order_header", "order_detail", "payment"],
      "enabled": true,
      "config_path": "gs://ntt-test-data-bq-looker-pipeline-configs/order/config.yaml",
      "storage_subfolder": "order/"
    },
    "product": {
      "tables": ["product_master", "product_category", "inventory"],
      "enabled": false,
      "config_path": "gs://ntt-test-data-bq-looker-pipeline-configs/product/config.yaml",
      "storage_subfolder": "product/"
    }
  },

  "windowing_config": {
    "global_windowing_enabled": "true",
    "windowing_monitoring_enabled": "true",
    "domain_specific_settings": {
      "member": { "windowing_enabled": "true" },
      "order": { "windowing_enabled": "true" },
      "product": { "windowing_enabled": "false" }
    }
  },

  "batch_domains": ["member", "order"],
  
  "pipeline_environments": {
    "dev": {
      "max_workers": 5,
      "machine_type": "n2-standard-2"
    },
    "staging": {
      "max_workers": 10,
      "machine_type": "n2-standard-4"
    },
    "prod": {
      "max_workers": 50,
      "machine_type": "n2-standard-8"
    }
  },
  
  "monitoring": {
    "enable_alerts": true,
    "slack_webhook": "https://hooks.slack.com/services/your/slack/webhook",
    "email_recipients": ["data-team@company.com", "ops-team@company.com"],
    "alert_thresholds": {
      "error_rate_percent": 5,
      "latency_minutes": 30,
      "data_quality_score": 70
    }
  },
  
  "storage_config": {
    "temp_location": "gs://ntt-test-data-bq-looker-dataflow-temp",
    "staging_location": "gs://ntt-test-data-bq-looker-dataflow-staging",
    "config_bucket": "ntt-test-data-bq-looker-pipeline-configs",
    "template_bucket": "ntt-test-data-bq-looker-dataflow-templates"
  },
  
  "security": {
    "kms_key_name": "projects/ntt-test-data-bq-looker/locations/asia-southeast1/keyRings/dataflow-ring/cryptoKeys/dataflow-key",
    "vpc_network": "projects/ntt-test-data-bq-looker/global/networks/vpc-network",
    "private_google_access": true
  }
}
